# Database
POSTGRES_USER=campusar
POSTGRES_PASSWORD=campusar_secret
POSTGRES_DB=campusar
DATABASE_URL=postgresql://campusar:campusar_secret@localhost:5433/campusar

# API
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
IOT_SIMULATOR=true

# Web — same-origin paths. Vite (dev) and nginx (Docker) both proxy /api and /ws to the API.
# Production Docker: do NOT set VITE_API_URL=http://localhost:4000/api (that is the user's device, not the server).
VITE_API_URL=/api
# Optional. Omit or use /ws so the client derives:
#   http  page → ws://<current-host>/ws
#   https page → wss://<current-host>/ws
# VITE_WS_URL=/ws

# Google Maps JavaScript API key (Hybrid 3D campus view). Leave empty to use Esri satellite + roads.
VITE_GOOGLE_MAPS_API_KEY=
