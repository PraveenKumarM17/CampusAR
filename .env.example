# Database
POSTGRES_USER=campusar
POSTGRES_PASSWORD=campusar_secret
POSTGRES_DB=campusar
DATABASE_URL=postgresql://campusar:campusar_secret@localhost:5433/campusar

# API
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
IOT_SIMULATOR=true

# Web — use /api so Vite proxies to the API in development
VITE_API_URL=/api
# Optional; omit to use same-origin /ws via Vite proxy
# VITE_WS_URL=ws://localhost:4000/ws
