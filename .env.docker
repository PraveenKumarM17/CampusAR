# Docker Environment Configuration for CampusAR
# Copy this file to .env before running docker-compose

# Database
POSTGRES_USER=campusar
POSTGRES_PASSWORD=campusar_secret_change_me_in_production
POSTGRES_DB=campusar

# API Security - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-very-secure!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-very-secure!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - Update for production domain
CORS_ORIGIN=https://localhost

# IoT Simulator
IOT_SIMULATOR=true

# Google Maps API (Optional - leave empty to use Esri satellite)
VITE_GOOGLE_MAPS_API_KEY=

# Node Environment
NODE_ENV=production
